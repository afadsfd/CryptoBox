# App Configuration
APP_NAME="CryptoBox API"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cryptofolio"

# Redis
REDIS_URL="redis://localhost:6379/0"

# JWT Configuration
# IMPORTANT: You MUST set these values in production. Leave empty to use dev defaults in DEBUG mode.
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (for API keys) - Must be set in production
# IMPORTANT: You MUST set this value in production. Leave empty to use dev defaults in DEBUG mode.
ENCRYPTION_KEY=""

# CORS - Comma-separated list of allowed origins (used in production)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# CoinGecko API
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
